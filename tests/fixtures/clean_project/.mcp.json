{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}" }
    },
    "remote-docs": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.1.29", "https://mcp.internal-tools.dev/sse"]
    },
    "docs": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.7.1", "./docs"]
    },
    "github-docker": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server@sha256:3f2a9c6b8d7e1f0a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@0.0.41"]
    },
    "search": {
      "type": "http",
      "url": "https://search.example-mcp.dev/mcp",
      "headers": { "Authorization": "Bearer ${SEARCH_TOKEN}" }
    },
    "local": {
      "url": "http://localhost:8787/mcp"
    },
    "pydocs": {
      "command": "uvx",
      "args": ["mcp-server-fetch==2025.4.7"]
    }
  }
}
